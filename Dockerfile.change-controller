FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /change-controller ./cmd/change-controller
FROM gcr.io/distroless/static:nonroot
COPY --from=build /change-controller /change-controller
USER 65532:65532
ENTRYPOINT ["/change-controller"]
