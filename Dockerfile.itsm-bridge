FROM golang:1.26.5 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /itsm-bridge ./cmd/itsm-bridge
FROM scratch
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /itsm-bridge /itsm-bridge
USER 65532:65532
ENTRYPOINT ["/itsm-bridge"]
