FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG AEP_VERSION=dev
RUN CGO_ENABLED=0 go build -ldflags "-X github.com/tym83/aep/internal/version.Version=${AEP_VERSION}" -trimpath -o /cozystack-mcp ./cmd/cozystack-mcp
FROM gcr.io/distroless/static:nonroot
COPY --from=build /cozystack-mcp /cozystack-mcp
USER 65532:65532
ENTRYPOINT ["/cozystack-mcp"]
