        "storageClass": "replicated",
        "version": "v1.35"
      }
    },
    "kubernetesnodeses/apps-md0": {
      "apiVersion": "apps.cozystack.io/v1alpha1",
      "kind": "KubernetesNodes",
      "metadata": {
        "labels": {
          "aep.aenix.io/organization": "org-uid"
        },
        "name": "apps-md0",
        "namespace": "tenant-acme-nonprod"
      },
      "spec": {
        "cluster": "apps",
        "diskSize": "20Gi",
        "instanceType": "u1.large",
        "maxReplicas": 3,
        "minReplicas": 2,
        "roles": [],
